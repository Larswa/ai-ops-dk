---
import { site } from "../config/site";
const year = new Date().getFullYear();

const links = [
  { label: "Cases", href: "/cases" },
  { label: "Blog", href: "/blog" },
  { label: "Self-hosted LLM", href: "/self-hosted-llm" },
  { label: "AI-governance", href: "/ai-governance" },
];
---

<footer class="bg-sunken border-t border-line">
  <div class="container-page py-14 flex flex-wrap justify-between gap-x-16 gap-y-8">
    <div class="flex flex-col gap-4 basis-64 grow">
      <img src="/logo/ai-ops-logo.svg" alt="AI Ops" width="112" height="23" class="block w-28 h-auto" />
      <p class="text-sm leading-[22px] text-muted">AI-understøttet sagsbehandling, fra idé til produktion.</p>
    </div>
    <div class="flex flex-wrap gap-x-16 gap-y-8 text-sm leading-6">
      <div class="flex flex-col gap-1">
        <h2 class="kicker text-muted pb-2">Kontakt</h2>
        <a href={`mailto:${site.email}`} class="text-ink">{site.email}</a>
        <div>{site.company.address}</div>
      </div>
      <div class="flex flex-col gap-1">
        <h2 class="kicker text-muted pb-2">Læs mere</h2>
        {links.map((l) => <a href={l.href} class="text-ink">{l.label}</a>)}
      </div>
      <div class="flex flex-col gap-1">
        <h2 class="kicker text-muted pb-2">AI Ops</h2>
        <div>{site.domain}</div>
        <div>{site.company.legalName}</div>
        <div>CVR {site.company.cvr}</div>
      </div>
    </div>
  </div>
  <div class="container-page pb-8 text-xs text-muted">© {year} {site.company.legalName}</div>
</footer>
