---
import { site } from "../config/site";
---

<section id="kontakt" class="bg-skifer text-skifer-ink">
  <div class="container-page py-16 md:py-24 flex flex-wrap items-center justify-between gap-x-16 gap-y-8">
    <h2 class="m-0 basis-[520px] grow font-serif text-[36px] leading-[42px] md:text-5xl md:leading-[54px] font-medium tracking-[-0.015em]">
      Skal vi tage en snak om, hvor I taber mest tid i dag?
    </h2>
    <div class="flex flex-col gap-3 basis-80 shrink">
      <a href={site.bookingUrl} class="btn-primary min-h-[52px] px-6 text-base">
        Book 30 minutter
      </a>
      <a href={`mailto:${site.email}`} class="text-sm text-center text-skifer-ink">{site.email}</a>
    </div>
  </div>
</section>
