---
import { site } from "../config/site";
---

<header class="border-b border-line bg-paper">
  <nav
    aria-label="Hovedmenu"
    class="container-page py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-4"
  >
    <a href="/" aria-label="AI Ops forside" class="flex items-center min-h-11">
      <img src="/logo/ai-ops-logo.svg" alt="AI Ops" width="128" height="27" class="block w-32 h-auto" />
    </a>
    <div class="flex flex-wrap items-center gap-x-7 gap-y-1 text-sm font-medium">
      {site.nav.map((item) => (
        <a href={item.href} class="py-3 text-ink no-underline hover:text-signal">{item.label}</a>
      ))}
      <a href={site.bookingUrl} class="btn-primary min-h-11 no-underline">
        Book et AI møde
      </a>
    </div>
  </nav>
</header>
