---
const cases = [
  { title: "Vandskade, parcelhus", type: "Skadesag · indskannet anmeldelse", action: "Udkast klar", system: 1 },
  { title: "Klage over afslag på dækning", type: "Kundehenvendelse · e-mail", action: "Assistent", system: 2 },
  { title: "Ændring af begunstiget", type: "Pension · selvbetjening", action: "Journaliseret", system: 1 },
  { title: "Uenighed om erstatningsopgørelse", type: "Skadesag · tredje henvendelse", action: "Assistent", system: 2 },
  { title: "Spørgsmål om indbetaling", type: "Kundehenvendelse · chat", action: "Besvaret", system: 1 },
];
---

<section class="bg-paper">
  <div id="top" class="container-page pt-16 pb-14 md:pt-24 md:pb-20 flex flex-wrap items-center gap-16">
    <div class="basis-[480px] grow min-w-0 flex flex-col gap-6">
      <div class="overline text-muted">Forsikring · Pension · Rådgivning · Finans</div>
      <h1 class="m-0 font-serif text-[40px] leading-[44px] md:text-[56px] md:leading-[60px] font-medium tracking-[-0.015em]">
        Jeres bedste sagsbehandlers erfaring i hænderne på alle.
      </h1>
      <p class="m-0 text-lg leading-7 text-muted max-w-[34em]">
        AI Ops automatiserer rutinen og giver medarbejderne en AI-assistent til de svære sager. Fra idé til produktion på uger, ikke år.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="#kontakt" class="btn-primary">Find ud af, hvor I taber tid</a>
        <a href="#systemer" class="btn-secondary">Se hvordan det virker</a>
      </div>
    </div>

    <figure class="m-0 basis-[440px] grow min-w-0 border border-line rounded-[2px] bg-raised" aria-label="Eksempel på indkomne sager">
      <div class="flex justify-between items-center px-6 py-4 border-b border-line bg-sunken">
        <div class="text-sm font-semibold">Indkomne sager</div>
        <div class="font-mono text-[13px] text-muted">i dag</div>
      </div>
      <ul class="m-0 p-0 list-none">
        {cases.map((c) => (
          <li class="flex flex-wrap gap-x-4 gap-y-2 items-center justify-between px-6 py-4 border-b border-line">
            <div class="min-w-0 basis-[200px] grow">
              <div class="text-[15px] leading-[22px] font-medium">{c.title}</div>
              <div class="text-[13px] leading-5 text-muted">{c.type}</div>
            </div>
            <div class="inline-flex items-center gap-2 px-[11px] py-[3px] bg-sunken text-ink rounded-[2px] text-[13px] leading-5 font-medium">
              {c.system === 1 ? (
                <span aria-hidden="true" class="inline-block w-1 h-3 bg-routine"></span>
              ) : (
                <span aria-hidden="true" class="inline-block w-2.5 h-2.5 bg-signal rounded-full"></span>
              )}
              System {c.system} · {c.action}
            </div>
          </li>
        ))}
      </ul>
      <figcaption class="px-6 py-4 text-sm text-muted">Mennesket beslutter. Hvert udkast godkendes af en medarbejder.</figcaption>
    </figure>
  </div>
</section>
